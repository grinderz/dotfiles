{{- /* passp: replace every {{passp:NAME}} placeholder in the given string with
       `passp show NAME` (first line) at apply time; MISSING when the entry
       does not exist yet, so apply keeps working. Usage:
       {{ includeTemplate "passp" $string }} */ -}}
{{- $u := . -}}
{{- range regexFindAll "\\{\\{passp:[^}]+\\}\\}" $u -1 -}}
{{- $name := . | trimPrefix "{{passp:" | trimSuffix "}}" -}}
{{- $secret := output "sh" "-c" (printf "{ passp show %s 2>/dev/null || echo MISSING; } | head -n1" $name) | trim -}}
{{- $u = replace . $secret $u -}}
{{- end -}}
{{- $u -}}
