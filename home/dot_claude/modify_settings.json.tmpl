#!/bin/sh
# Claude Code keeps its user-level defaults in this same file (/model,
# /config, allowlist additions, plugin toggles), so a plain template would
# wipe them on every apply. chezmoi hands the current file on stdin; the
# managed keys below are merged over it and everything else is kept. Keys
# are replaced whole, hence no "allow" list here: it belongs to the machine.
jq -n '[inputs] | (.[0] // {}) * $managed' --argjson managed "$(cat <<'JSON'
{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "default"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "darwin" }}
            "command": "jq -r '.message' | xargs -I {} terminal-notifier -title 'Claude Code' -message \"{}\" -sound Glass -group claude-code"
{{- else }}
            "command": "jq -r '.message' | xargs -I {} notify-send 'Claude Code' \"{}\""
{{- end }}
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "darwin" }}
            "command": "terminal-notifier -title 'Claude Code' -message \"Done in $(basename $(pwd))\" -sound Hero -group claude-code"
{{- else }}
            "command": "notify-send 'Claude Code' \"Done in $(basename $(pwd))\""
{{- end }}
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
JSON
)"
