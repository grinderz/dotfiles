#!/bin/sh
# Claude Code keeps its user-level defaults in this same file (/model,
# /config, allowlist additions, plugin toggles), so a plain template would
# wipe them on every apply. chezmoi hands the current file on stdin; the
# managed keys below are merged over it and everything else is kept. Keys
# are replaced whole except deny lists, which keep local restrictions too
# while removing managed paths for the other OS and those listed in
# agents.retired_deny_paths: a path only dropped from deny_paths would stay,
# since nothing tells it apart from a local restriction.
#
# The caveman marketplace is not pinned; third-party marketplaces do not
# auto-update, so it moves on `/plugin marketplace update caveman`.
{{- $rules := list }}
{{- $otherRules := list }}
{{- $otherPaths := list }}
{{- $paths := get .agents.deny_paths .chezmoi.os | default list }}
{{- $retired := dig "retired_deny_paths" (list) .agents }}
{{- range $retired }}{{ if has . $paths }}
{{- fail (printf "%s is both in agents.deny_paths.%s and agents.retired_deny_paths" . $.chezmoi.os) }}
{{- end }}{{ end }}
{{- range $os, $osPaths := merge (dict "retired" $retired) .agents.deny_paths }}
{{- range $osPaths }}
{{- $pattern := . }}
{{- if not (hasSuffix ".plist" .) }}
{{- $pattern = printf "%s/**" . }}
{{- end }}
{{- if eq $os $.chezmoi.os }}
{{- $rules = append $rules (printf "Read(%s)" $pattern) }}
{{- $rules = append $rules (printf "Edit(%s)" $pattern) }}
{{- else }}
{{- $otherPaths = append $otherPaths . }}
{{- $otherRules = append $otherRules (printf "Read(%s)" $pattern) }}
{{- $otherRules = append $otherRules (printf "Edit(%s)" $pattern) }}
{{- end }}
{{- end }}
{{- end }}
jq -n '[inputs] | (.[0] // {}) as $current | $current * $managed |
    .permissions.deny = ((($current.permissions.deny // []) + $managed.permissions.deny | unique) - $otherRules) |
    .sandbox.filesystem.denyRead = ((($current.sandbox.filesystem.denyRead // []) + $managed.sandbox.filesystem.denyRead | unique) - $otherPaths) |
    .sandbox.filesystem.denyWrite = ((($current.sandbox.filesystem.denyWrite // []) + $managed.sandbox.filesystem.denyWrite | unique) - $otherPaths)' \
    --argjson otherRules {{ $otherRules | toJson | squote }} \
    --argjson otherPaths {{ $otherPaths | toJson | squote }} \
    --argjson managed "$(cat <<'JSON'
{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "DO_NOT_TRACK": 1,
    "CLAUDE_CODE_AUTO_CONNECT_IDE": 0,
    "ENABLE_PROMPT_CACHING_1H": 1,
    "TZ": "America/New_York"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "default",
    "deny": {{ $rules | toJson }}
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [],
    "filesystem": {
      "disabled": false,
      "denyRead": {{ $paths | toJson }},
      "denyWrite": {{ $paths | toJson }}
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/bin/agent-bash-guard"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "darwin" }}
            "command": "jq -r '.message' | xargs -I {} terminal-notifier -title 'Claude Code' -message \"{}\" -sound Glass -group claude-code"
{{- else }}
            "command": "jq -r '.message' | xargs -I {} notify-send 'Claude Code' \"{}\""
{{- end }}
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "darwin" }}
            "command": "terminal-notifier -title 'Claude Code' -message \"Done in $(basename $(pwd))\" -sound Hero -group claude-code"
{{- else }}
            "command": "notify-send 'Claude Code' \"Done in $(basename $(pwd))\""
{{- end }}
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "gopls-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoDreamEnabled": true,
  "awaySummaryEnabled": false,
  "promptSuggestionEnabled": false
}
JSON
)"
