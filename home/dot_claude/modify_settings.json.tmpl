#!/bin/sh
# Claude Code keeps its user-level defaults in this same file (/model,
# /config, allowlist additions, plugin toggles), so a plain template would
# wipe them on every apply. chezmoi hands the current file on stdin; the
# managed keys below are merged over it and everything else is kept. Keys
# are replaced whole except deny lists, which keep local restrictions too.
{{- $rules := list }}
{{- range .agents.deny_paths }}
{{- $pattern := . }}
{{- if not (hasSuffix ".plist" .) }}
{{- $pattern = printf "%s/**" . }}
{{- end }}
{{- $rules = append $rules (printf "Read(%s)" $pattern) }}
{{- $rules = append $rules (printf "Edit(%s)" $pattern) }}
{{- end }}
jq -n '[inputs] | (.[0] // {}) as $current | $current * $managed |
    .permissions.deny = (($current.permissions.deny // []) + $managed.permissions.deny | unique) |
    .sandbox.filesystem.denyRead = (($current.sandbox.filesystem.denyRead // []) + $managed.sandbox.filesystem.denyRead | unique) |
    .sandbox.filesystem.denyWrite = (($current.sandbox.filesystem.denyWrite // []) + $managed.sandbox.filesystem.denyWrite | unique)' \
    --argjson managed "$(cat <<'JSON'
{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "default",
    "deny": {{ $rules | toJson }}
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [],
    "filesystem": {
      "disabled": false,
      "denyRead": {{ .agents.deny_paths | toJson }},
      "denyWrite": {{ .agents.deny_paths | toJson }}
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/bin/agent-bash-guard"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "darwin" }}
            "command": "jq -r '.message' | xargs -I {} terminal-notifier -title 'Claude Code' -message \"{}\" -sound Glass -group claude-code"
{{- else }}
            "command": "jq -r '.message' | xargs -I {} notify-send 'Claude Code' \"{}\""
{{- end }}
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "darwin" }}
            "command": "terminal-notifier -title 'Claude Code' -message \"Done in $(basename $(pwd))\" -sound Hero -group claude-code"
{{- else }}
            "command": "notify-send 'Claude Code' \"Done in $(basename $(pwd))\""
{{- end }}
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
JSON
)"
