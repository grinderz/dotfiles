#!/bin/sh
# Keeps the [data.jetbrains] lines in the user vmoptions file of every
# installed JetBrains IDE. The launcher concatenates its own
# bin/<bin>.vmoptions with this one, so only the extra options belong here.
# Everything outside the markers is left alone: options added by hand or
# through Help | Edit Custom VM Options survive an apply.
#
# Order inside the block is options, per_product, per_host — the JVM takes
# the last of two conflicting values, so the more specific key wins.
#
# Not run_onchange_: an IDE upgrade creates a new config directory
# (GoLand2026.2 -> GoLand2026.3) without changing this script, so the hash
# would not move and the new version would start without the options.
set -eu

{{ if eq .chezmoi.os "darwin" -}}
root="$HOME/Library/Application Support/JetBrains"
suffix=""

# the launcher binary carries the same name as the config directory in
# lower case, so an uninstalled IDE that left its config behind is skipped
installed() {
    for launcher in /Applications/*.app/Contents/MacOS/"$1" \
        "$HOME"/Applications/*.app/Contents/MacOS/"$1" \
        "$HOME"/Applications/*/*.app/Contents/MacOS/"$1"; do
        [ -x "$launcher" ] && return 0
    done
    return 1
}
{{- else -}}
root="${XDG_CONFIG_HOME:-$HOME/.config}/JetBrains"
suffix="64"

installed() { command -v "$1" >/dev/null 2>&1; }
{{- end }}
[ -d "$root" ] || exit 0

begin="# chezmoi vmoptions start"
end="# chezmoi vmoptions end"

# every option is rendered single quoted: the file is read by the launcher,
# not by a shell, so a $ or a backtick in it has to stay literal
options=$(
{{ range dig "jetbrains" "options" (list) . -}}
    printf '%s\n' {{ . | squote }}
{{ end -}}
)

# this machine only; the private toml is shared by every machine over
# syncthing, so memory sizes and the like are keyed by hostname
host_options=$(
{{ range dig "jetbrains" "per_host" .chezmoi.hostname (list) . -}}
    printf '%s\n' {{ . | squote }}
{{ end -}}
)

# keyed by the config directory name without the version (GoLand, PyCharm)
product_options() {
    case "$1" in
{{ range $product, $opts := dig "jetbrains" "per_product" (dict) . }}        {{ $product }})
{{ range $opts }}            printf '%s\n' {{ . | squote }}
{{ end }}            ;;
{{ end }}        *) ;;
    esac
}

append() {
    [ -n "$1" ] || return 0
    block="$block$1
"
}

for product in $(ls "$root" | sed -nE 's/^([A-Za-z]+)[0-9]{4}\.[0-9]+$/\1/p' | sort -u); do
    # the newest config directory of that product only; the ones an older
    # version left behind stay as they are
    dir=$(ls -d "$root/$product"[0-9]* | sort -V | tail -n1)
    case "$product" in
        IntelliJIdea*) bin="idea" ;;
        *) bin=$(printf '%s' "$product" | tr '[:upper:]' '[:lower:]') ;;
    esac
    installed "$bin" || continue
    file="$dir/$bin$suffix.vmoptions"

    block=""
    append "$options"
    append "$(product_options "$product")"
    append "$host_options"

    kept=""
    if [ -f "$file" ]; then
        kept=$(sed "/^$begin\$/,/^$end\$/d" "$file")
    fi

    new="$kept"
    if [ -n "$block" ]; then
        if [ -n "$new" ]; then
            new="$new
"
        fi
        new="$new$begin
$block$end"
    fi

    if [ -f "$file" ] && [ "$new" = "$(cat "$file")" ]; then
        continue
    fi
    printf '%s\n' "$new" > "$file"
    echo "jetbrains: vmoptions written to $file"
done
