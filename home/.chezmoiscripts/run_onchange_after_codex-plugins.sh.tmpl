#!/bin/sh
# Native plugin installation only: no Caveman proxy, npm installer or auth changes.
# Plugin hooks still require review in Codex /hooks before they can execute.
set -eu
command -v codex >/dev/null 2>&1 || exit 0
# A rendered wrapper may exist on a backup host without the real binary.
codex --version >/dev/null 2>&1 || exit 0
command -v node >/dev/null 2>&1 || { echo "codex plugins: Caveman requires node" >&2; exit 1; }
# Unpinned: the default branch at install time, then
# `codex plugin marketplace upgrade caveman` moves it.
repo=JuliusBrussee/caveman
# Re-adding the same source is a no-op, but Codex refuses to change the
# source of an added marketplace in place (an older pinned ref, say). Drop
# it first then; the plugin stays enabled and `plugin add` reinstalls it.
if ! out=$(codex plugin marketplace add "$repo" --json 2>&1); then
    case $out in
        *'already added from a different source'*)
            codex plugin marketplace remove caveman
            codex plugin marketplace add "$repo" --json ;;
        *)
            printf '%s\n' "$out" >&2
            exit 1 ;;
    esac
else
    printf '%s\n' "$out"
fi
codex plugin add caveman@caveman --json
