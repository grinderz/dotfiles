{{ if eq .chezmoi.os "darwin" -}}
Include ~/.colima/ssh_config
{{ end -}}

# HOME

host rtr1-gl-mt6000
  Hostname rtr1-gl-mt6000
  User root
  Port 22
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_ed25519_sk_rk_personal-ansible

host rtr3-almond-s3
  Hostname 192.168.12.1
  User root
  Port 22
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_ed25519_sk_rk_personal-ansible

host dock2-mokin-3707
  Hostname dock2-mokin-3707
  Port 22
  User obsd
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_ed25519_sk_rk_personal-ansible

host srv1-rpi3-nut-es700
  Hostname srv1-rpi3-nut-es700
  Port 22
  User root
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_ed25519_sk_rk_personal-ansible

host srv4-hp-ms8-backup
  Hostname srv4-hp-ms8-backup
  Port 22
  User root
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_ed25519_sk_rk_personal-sa

host kvm2-hp-ms8-virtual
    Hostname kvm2-hp-ms8-virtual
    Port 2280
    User Administrator
    KexAlgorithms diffie-hellman-group14-sha1,diffie-hellman-group1-sha1

host srv3-hp-ms8-virtual
  Hostname srv3-hp-ms8-virtual
  Port 22
  User root
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_ed25519_sk_rk_personal-sa

# GIT

host github.com
  Hostname github.com
  User git
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_ed25519_sk_rk_personal-sa

host gitlab.com
  Hostname gitlab.com
  User git
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_ed25519_sk_rk_personal-sa

# KVM


# OTH

host aur.archlinux.org
    User aur

# Work

{{ if hasKey . "work" -}}
{{ .work.ssh_hosts }}
{{ end -}}

# VPS

{{ if hasKey . "vps" -}}
{{ .vps.ssh_hosts }}
{{ end -}}

Host *
    PubkeyAuthentication no
    IdentityAgent none
    IdentitiesOnly yes

    CheckHostIP yes
    PreferredAuthentications publickey,keyboard-interactive,password
    TCPKeepAlive yes
    ServerAliveInterval 15
    ServerAliveCountMax 3

    SendEnv LANG LC_*
    SetEnv TERM=xterm-256color

    CASignatureAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes256-ctr
    HostbasedAcceptedAlgorithms ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,sk-ssh-ed25519@openssh.com
    HostKeyAlgorithms ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256
    KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256
    PubkeyAcceptedAlgorithms ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,sk-ssh-ed25519@openssh.com

# vi:syntax=sshconfig
