{{ if eq .chezmoi.os "darwin" -}}
Include ~/.colima/ssh_config
{{ end -}}

# HOME

{{ if hasKey .personal "ssh_hosts" -}}
{{ .personal.ssh_hosts }}
{{ end -}}

# GIT

host github.com
  Hostname github.com
  User git
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_ed25519_sk_rk_personal-sa

host gitlab.com
  Hostname gitlab.com
  User git
  PubkeyAuthentication yes
  IdentityFile ~/.ssh/id_ed25519_sk_rk_personal-sa

# KVM


# OTH

host aur.archlinux.org
    User aur

# Work

{{ if hasKey . "work" -}}
{{ .work.ssh_hosts }}
{{ end -}}

# VPS

{{ if hasKey . "vps" -}}
{{ .vps.ssh_hosts }}
{{ end -}}

Host *
    PubkeyAuthentication no
    IdentityAgent none
    IdentitiesOnly yes

    CheckHostIP yes
    PreferredAuthentications publickey,keyboard-interactive,password
    TCPKeepAlive yes
    ServerAliveInterval 15
    ServerAliveCountMax 3

    SendEnv LANG LC_*
    SetEnv TERM=xterm-256color

    CASignatureAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes256-ctr
    HostbasedAcceptedAlgorithms ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,sk-ssh-ed25519@openssh.com
    HostKeyAlgorithms ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256
    KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256
    PubkeyAcceptedAlgorithms ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,sk-ssh-ed25519@openssh.com

# vi:syntax=sshconfig
