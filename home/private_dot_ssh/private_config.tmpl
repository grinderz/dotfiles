{{- /* the personal YubiKey of this machine: every machine has its own,
       personal_key_by_host in the private chezmoi.toml (identical on all
       of them) maps hostname -> key, the rest fall back to personal_key */ -}}
{{- $pkey := .personal.personal_key -}}
{{- with (get .personal "personal_key_by_host") }}{{ $pkey = dig $.chezmoi.hostname $pkey . }}{{ end -}}
{{- /* one host entry from the lists in the private chezmoi.toml: only
       name is required, the rest defaults to Hostname = name, User =
       root, no Port line and IdentityFile = the key above */ -}}
{{- define "sshhost" -}}
{{- $h := . -}}
host {{ $h.name }}
{{- with (get $h "hostname") }}
  Hostname {{ . }}
{{- end }}
  User {{ default "root" (get $h "user") }}
{{- with (get $h "port") }}
  Port {{ . }}
{{- end }}
{{- with (get $h "key") }}
  PubkeyAuthentication yes
{{- if (get $h "agent") }}
  IdentityAgent SSH_AUTH_SOCK
{{- end }}
  IdentityFile {{ . }}
{{- end }}
{{- range (default (list) (get $h "extra")) }}
  {{ . }}
{{- end }}
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
Include ~/.colima/ssh_config
{{ end -}}

{{- $all := concat .personal.hosts .personal.git_hosts .personal.oth_hosts -}}
{{- if hasKey . "work" }}{{ $all = concat $all .work.hosts }}{{ end -}}
{{- if hasKey . "vps" }}{{ $all = concat $all .vps.hosts }}{{ end -}}
{{- /* everything that did not name a key of its own shares this one */ -}}
{{- $shared := list -}}
{{- range $all }}{{ if not (hasKey . "key") }}{{ $shared = append $shared .name }}{{ end }}{{ end -}}
host {{ join " " $shared }}
  PubkeyAuthentication yes
  IdentityFile {{ $pkey }}

{{ range $all }}{{ template "sshhost" . }}
{{ end -}}
Host *
    PubkeyAuthentication no
    IdentityAgent none
    IdentitiesOnly yes

    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m

    CheckHostIP yes
    PreferredAuthentications publickey,keyboard-interactive,password
    TCPKeepAlive yes
    ServerAliveInterval 15
    ServerAliveCountMax 3

    SendEnv LANG LC_*
    SetEnv TERM=xterm-256color

    CASignatureAlgorithms ssh-ed25519,sk-ssh-ed25519@openssh.com
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes256-ctr
    HostbasedAcceptedAlgorithms ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,sk-ssh-ed25519@openssh.com
    HostKeyAlgorithms ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256
    KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256
    PubkeyAcceptedAlgorithms ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,sk-ssh-ed25519@openssh.com

# vi:syntax=sshconfig
