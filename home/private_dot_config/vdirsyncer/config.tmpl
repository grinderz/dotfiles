# vdirsyncer: mirrors every calendar from [[data.cal.accounts]] (private
# chezmoi.toml) into ~/.local/share/calendars/<name>/ for khal. Meetings
# with attendees are still Evolution's job — this is the fast local view.
# Run by vdirsyncer.timer.
#
# Account schema (TOML):
#   [[data.cal.accounts]]
#   name  = "work"            # local dir, pair name, khal section
#   kind  = "davmail"         # davmail | google | caldav
#   email = "user@host.tld"
#   user  = "login"           # optional, defaults to email
#   pass  = "mail/work"       # optional pass entry, defaults to mail/<name>
#   pass_dir = "/abs/path"    # optional alternate password store
#   url   = "https://..."     # kind = "caldav" only
#
# kind presets: davmail = local bridge CalDAV on 127.0.0.1:1080 (Exchange
# creds, same as the mail account); google = Google Calendar API with
# OAuth (client id/secret from the pass entries named by
# data.cal.google_client_id_pass / google_client_secret_pass, defaults
# oauth/google/client-id and oauth/google/client-secret; token cached in
# ~/.local/state/vdirsyncer; needs python-aiohttp-oauthlib); caldav =
# generic server.

[general]
status_path = "{{ .chezmoi.homeDir }}/.local/state/vdirsyncer/status"
{{ range .cal.accounts }}
{{- /* vdirsyncer allows only [A-Za-z0-9_] in pair/storage names; keep
       the original name for filesystem paths and khal */ -}}
{{ $id := .name | replace "-" "_" }}
[pair {{ $id }}]
a = "{{ $id }}_local"
b = "{{ $id }}_remote"
collections = ["from a", "from b"]
metadata = ["displayname", "color"]

[storage {{ $id }}_local]
type = "filesystem"
path = "{{ $.chezmoi.homeDir }}/.local/share/calendars/{{ .name }}"
fileext = ".ics"

[storage {{ $id }}_remote]
{{ if eq .kind "davmail" -}}
type = "caldav"
url = "http://127.0.0.1:1080/users/{{ .email }}/calendar/"
username = "{{ default .email (get . "user") }}"
password.fetch = ["command", "sh", "-c", "{{ with get . "pass_dir" }}PASSWORD_STORE_DIR={{ . }} {{ end }}{{ $.chezmoi.homeDir }}/.local/bin/pass-cache show {{ default (printf "mail/%s" .name) (get . "pass") }}"]
{{ else if eq .kind "google" -}}
type = "google_calendar"
token_file = "{{ $.chezmoi.homeDir }}/.local/state/vdirsyncer/token_{{ .name }}"
client_id.fetch = ["command", "sh", "-c", "{{ $.chezmoi.homeDir }}/.local/bin/pass-cache show {{ default "oauth/google/client-id" (get $.cal "google_client_id_pass") }}"]
client_secret.fetch = ["command", "sh", "-c", "{{ $.chezmoi.homeDir }}/.local/bin/pass-cache show {{ default "oauth/google/client-secret" (get $.cal "google_client_secret_pass") }}"]
{{ else -}}
type = "caldav"
url = "{{ .url }}"
username = "{{ default .email (get . "user") }}"
password.fetch = ["command", "sh", "-c", "{{ with get . "pass_dir" }}PASSWORD_STORE_DIR={{ . }} {{ end }}{{ $.chezmoi.homeDir }}/.local/bin/pass-cache show {{ default (printf "mail/%s" .name) (get . "pass") }}"]
{{ end -}}
{{ end }}
