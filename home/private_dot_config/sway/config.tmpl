# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term foot
# Your preferred application launcher
set $menu fuzzel

# Titlebars/swaynag; same face as the waybar stack (ttf-roboto)
font pango:Monospace 10

# Workspace names: number stays first so $mod+N binds and the keyboard
# number layer keep working; the label shows up in waybar.
set $ws1 "1:cli"
set $ws2 "2:dev"
set $ws3 "3:web"
set $ws4 "4:ide"
set $ws5 "5:wrk"
set $ws6 "6:eml"
set $ws7 "7:doc"
set $ws9 "9:msg"

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

# Output layout is managed by kanshi (~/.config/kanshi/config): it picks
# a profile for whatever set of monitors is connected, including hotplug.
# exec_always: sway reload resets outputs to defaults (kanshi's layout is
# not part of sway's config), so re-apply the profile on every reload;
# on session start kanshictl fails fast and the daemon gets started.
exec_always 'kanshictl reload || kanshi'

# Clamshell mode: disable the builtin screen when the lid is closed.
# kanshi cannot see lid state, so this is handled by sway directly.
bindswitch --reload --locked lid:on output eDP-1 disable
bindswitch --reload --locked lid:off output eDP-1 enable

output * bg {{ .desktop.wallpaper_dir }}/marek-piwnicki.jpg fill

# Random wallpaper from the directory on session start
exec 'swaymsg output "*" bg "$(find {{ .desktop.wallpaper_dir }} -type f | shuf -n 1)" fill'

### Idle configuration
#
# Example configuration:
#
# exec swayidle -w \
#          timeout 300 'swaylock -f -c 000000' \
#          timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#          before-sleep 'swaylock -f -c 000000'
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.
#
# Events live in ~/.config/swayidle/config
exec swayidle -w

# Night light: color temperature follows the sun at the given location
# (coordinates live in the private chezmoi.toml, [data.desktop])
exec wlsunset -l {{ .desktop.latitude }} -L {{ .desktop.longitude }} -t 4000 -T 6500

### Input configuration
#
# Example configuration:
#
#   input type:touchpad {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
#   input type:keyboard {
#       xkb_layout "eu"
#   }
#
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.

input "1452:613:Apple_Inc._Magic_Trackpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    click_method clickfinger
    drag disabled
    pointer_accel 0
    scroll_factor 1.0
}

input type:keyboard {
    xkb_layout "us,ru"
    xkb_options grp:caps_toggle
}

# Focus stays put; stray trackpad hovers must not steal it
#focus_follows_mouse no

### Windows
#
# No border/titlebar edges for a lone window on an output
hide_edge_borders smart

# Volume mixer opened from the waybar pulseaudio module
for_window [app_id="mixer"] floating enable

# GPG/YubiKey pin prompts: any pinentry backend the wrapper picks,
# plus the gcr system prompter used by pinentry-gnome3.
# pinentry-gtk runs via XWayland, hence the class criteria next to app_id.
for_window [app_id="^pinentry-"] floating enable
for_window [class="(?i)^pinentry"] floating enable
for_window [app_id="gcr-prompter"] floating enable

# Portal file chooser remembers its size from the big externals and then
# overflows the builtin screen; clamp it to the current workspace instead
for_window [app_id="xdg-desktop-portal-gtk"] floating enable, resize set width 80 ppt height 80 ppt, move position center

# Long-lived apps open on their dedicated workspace: browser 3 and work
# browser 5, notes 7 and chats 9 (left Dell), IDE 4 and mail 6
# (right Dell)
assign [app_id="brave-browser"] workspace $ws3
assign [app_id="jetbrains-pycharm"] workspace $ws4
assign [app_id="firefox"] workspace $ws5
assign [app_id="org.gnome.Evolution"] workspace $ws6
assign [app_id="com.ayugram.desktop"] workspace $ws9
assign [app_id="md.obsidian.Obsidian"] workspace $ws7

# Autostart terminals on the primary workspaces: zellij dev(2, right
# Dell) and a plain shell (1, left Dell). Dedicated app-ids keep the assign
# rules away from ad-hoc $mod+Return terminals and avoid the startup race a
# `swaymsg 'workspace N; exec ...'` chain would have.
assign [app_id="foot-dev"] workspace $ws2
assign [app_id="foot-cli"] workspace $ws1
exec foot --app-id=foot-dev zellij attach --create dev
exec foot --app-id=foot-cli

# Drop-down terminal living in the scratchpad: $mod+minus anywhere
for_window [app_id="foot-scratch"] move scratchpad, resize set 1200 700
exec foot --app-id=foot-scratch

# Long-lived apps land on their assigned workspaces (see assign rules above)
exec brave
exec flatpak run com.ayugram.desktop
exec obsidian

### Gestures
#
# macOS-like workspace switching: three-finger horizontal swipe.
# Directions match natural scrolling (swipe left = go to workspace on the right).
bindgesture swipe:4:left workspace next_on_output
bindgesture swipe:4:right workspace prev_on_output

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Lock the screen (force en layout first)
    bindsym $mod+Escape exec '$HOME/.local/bin/lock'

    # Power button locks instead of suspending (logind: HandlePowerKey=ignore)
    bindsym --locked XF86PowerOff exec '$HOME/.local/bin/lock'

    # Start your launcher
    bindsym $mod+d exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Jump to the most recent urgent window
    bindsym $mod+x [urgent=latest] focus

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Move the container to the neighbouring output (the other Dell)
    bindsym $mod+less move container to output left
    bindsym $mod+greater move container to output right

    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace $ws1
    bindsym $mod+2 workspace $ws2
    bindsym $mod+3 workspace $ws3
    bindsym $mod+4 workspace $ws4
    bindsym $mod+5 workspace $ws5
    bindsym $mod+6 workspace $ws6
    bindsym $mod+7 workspace $ws7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace $ws9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace $ws1
    bindsym $mod+Shift+2 move container to workspace $ws2
    bindsym $mod+Shift+3 move container to workspace $ws3
    bindsym $mod+Shift+4 move container to workspace $ws4
    bindsym $mod+Shift+5 move container to workspace $ws5
    bindsym $mod+Shift+6 move container to workspace $ws6
    bindsym $mod+Shift+7 move container to workspace $ws7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace $ws9
    bindsym $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.

    # Fresh empty workspace (first free number from 11) on the focused
    # output; Shift variant takes the focused window along
    bindsym $mod+n exec $HOME/.local/bin/fresh-workspace
    bindsym $mod+Shift+n exec $HOME/.local/bin/fresh-workspace move

    # Pin workspaces to outputs (docked profile in ~/.config/kanshi/config).
    # Odd workspaces sit on the left Dell, even on the right one, mirroring
    # the keyboard's number layer: odd digits live on the left half, even on
    # the right, so the hand matches the monitor side. eDP-1 is the fallback:
    # with no externals connected everything lands on the builtin screen.
    workspace $ws1 output '{{ .desktop.output_left }}' eDP-1
    workspace $ws3 output '{{ .desktop.output_left }}' eDP-1
    workspace $ws5 output '{{ .desktop.output_left }}' eDP-1
    workspace $ws7 output '{{ .desktop.output_left }}' eDP-1
    workspace $ws9 output '{{ .desktop.output_left }}' eDP-1
    workspace $ws2 output '{{ .desktop.output_right }}' eDP-1
    workspace $ws4 output '{{ .desktop.output_right }}' eDP-1
    workspace $ws6 output '{{ .desktop.output_right }}' eDP-1
    workspace 8 output '{{ .desktop.output_right }}' eDP-1
    workspace 10 output '{{ .desktop.output_right }}' eDP-1
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities:
#
    # Special keys to adjust volume via PulseAudio
    bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
    bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
    bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
    bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

    # Special keys to control media via playerctl
    bindsym --locked XF86AudioPlay exec playerctl play-pause
    bindsym --locked XF86AudioPause exec playerctl play-pause
    bindsym --locked XF86AudioPrev exec playerctl previous
    bindsym --locked XF86AudioNext exec playerctl next
    bindsym --locked XF86AudioStop exec playerctl stop

    # Special keys to adjust brightness via brightnessctl
    bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
    bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

    # Screenshots via grimshot (sway-contrib); $mod+p variants work from
    # keyboards without a Print key. Area save first: the most used one
    # goes on the lightest chord.
    # smart area: drag = freeform, click = window/output (region-select)
    bindsym $mod+p exec $HOME/.local/bin/smart-screenshot    # area to file

    bindsym $mod+Shift+p exec grimshot copy area             # area to clipboard
    bindsym $mod+Ctrl+p exec grimshot --notify save active   # active window
    bindsym $mod+Alt+p exec grimshot --notify save output    # current monitor

    # OCR an area to the clipboard (eng+rus; needs tesseract-data-*)
    bindsym $mod+o exec 'grim -g "$(slurp)" - | tesseract -l eng+rus - - | wl-copy'

    # Screen recording via wf-recorder; the same key stops a running
    # recording and the notification tells where the file landed
    bindsym $mod+Shift+o exec $HOME/.local/bin/screen-record region
    bindsym $mod+Ctrl+o exec $HOME/.local/bin/screen-record output

    # decode a QR code from a screen region into the clipboard (needs zbar)
    bindsym $mod+Alt+o exec $HOME/.local/bin/qr-scan

    # keybinding cheatsheet generated from this config
    bindsym $mod+i exec $HOME/.local/bin/sway-bindings

    # launch-or-focus: one key always shows the app
    bindsym $mod+m exec $HOME/.local/bin/launch-or-focus evolution evolution      # mail
    bindsym $mod+t exec $HOME/.local/bin/launch-or-focus ayugram AyuGram          # telegram
    bindsym $mod+g exec $HOME/.local/bin/launch-or-focus obsidian obsidian        # notes

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
# waybar auto-restart wrapper, kept for reference: waybar 0.15.0 segfaulted
# in gtk when racing kanshi's output reconfiguration at session start
# (duplicate bar on eDP-1); re-enable if the crashes come back
# exec sh -c 'sleep 2; while :; do waybar >> "${XDG_RUNTIME_DIR:-/tmp}/waybar.log" 2>&1; sleep 2; done'

bar {
    position top

    # When the status_command prints a new line to stdout, swaybar updates.
    # The default just shows the current date and time.
    # status_command while date +'%Y-%m-%d %X'; do sleep 1; done

    swaybar_command waybar

    colors {
        statusline #ffffff
        background #323232
        inactive_workspace #32323200 #32323200 #5c5c5c
    }
}

include /etc/sway/config.d/*
