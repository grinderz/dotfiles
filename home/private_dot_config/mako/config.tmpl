# Tokyo Night Storm, roles from [theme] in .chezmoidata.toml
background-color=#{{ .theme.bg }}
text-color=#{{ .theme.fg }}
border-color=#{{ .theme.border }}

# Dismiss notifications automatically (mako default is 0 = never)
default-timeout=15000
# Apply default-timeout even when the app requests a persistent notification
ignore-timeout=1
# Middle click lists the notification's actions (Telegram's "Open", a
# calendar reminder's "Snooze") in the same picker the bar menus use;
# notifications without actions just close as before
on-button-middle=exec makoctl menu -n "$id" -- $HOME/.local/bin/menu-pick --prompt="action "

# New-mail notifications hang around long enough to catch after stepping
# away (mail-notify sends with app name "mail")
[app-name=mail]
default-timeout=600000
ignore-timeout=0

# Calendar reminders (birthdays, meetings) stay until dismissed
[app-name=evolution-alarm-notify]
default-timeout=0
ignore-timeout=0

# "dnd" mode (waybar notify-toggle): hide everything but critical; the
# later, more specific section wins. Hidden ones still land in history
[mode=dnd]
invisible=1

[mode=dnd urgency=critical]
invisible=0

# Critical notifications stay until dismissed, and shout: the theme's
# critical red as the background, dark text on it
[urgency=critical]
default-timeout=0
ignore-timeout=0
background-color=#{{ .theme.critical }}
text-color=#{{ .theme.bg }}
border-color=#{{ .theme.critical }}
