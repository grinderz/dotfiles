# update-openvpn-password.sh (~/src/personal/openwrt-scripts): rendered by
# dotfiles from the [[data.routers]] entry with an openvpn table. Shell
# KEY=VALUE, see update-openvpn-password.conf.example in the repo for the keys
{{- range $r := .routers }}{{ with get $r "openvpn" }}
HOST="{{ default $r.name (get $r "ssh") }}"
IFACE="{{ .iface }}"
USERNAME="{{ .username }}"
PASSWORD_CMD="{{ .password_cmd }}"
WAIT={{ default 30 (get . "wait") }}
{{- end }}{{ end }}
