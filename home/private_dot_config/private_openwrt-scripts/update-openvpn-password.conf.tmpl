# update-openvpn-password.sh in the openwrt-scripts repo: rendered by
# dotfiles from the [[data.openwrt_hosts]] entry with an openvpn table. Shell
# KEY=VALUE, see update-openvpn-password.conf.example in the repo for the keys
{{- range $r := .openwrt_hosts }}{{ with get $r "openvpn" }}
HOST="{{ default $r.name (get $r "ssh") }}"
IFACE="{{ .iface }}"
USERNAME="{{ .username }}"
PASSWORD_CMD="{{ .password_cmd }}"
WAIT={{ default 30 (get . "wait") }}
{{- end }}{{ end }}
