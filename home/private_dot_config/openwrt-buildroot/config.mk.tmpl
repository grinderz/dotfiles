# openwrt-buildroot (~/src/personal/openwrt-buildroot): the build host `make
# deploy` syncs to, the public URL of the asu proxy and the build selection /
# image names, from [data.openwrt] and [data.openwrt.buildroot] in the private
# toml. The repo Makefile includes this file and copies it to local.mk in the
# checkout (make also runs on the build host, which has no ~/.config)
DEPLOY_DEST := {{ .openwrt.build_host }}:{{ .openwrt.build_src }}/openwrt-buildroot
ASU_UPSTREAM_CUSTOM := {{ .openwrt.asu_upstream }}
{{- range $k, $v := .openwrt.buildroot }}
{{ $k }} := {{ $v }}
{{- end }}
