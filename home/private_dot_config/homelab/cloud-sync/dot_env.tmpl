# cloud-sync/.env of ~/src/personal/homelab, rendered by dotfiles from
# [data.homelab.cloud_sync] in the private toml (keys as in .env.example;
# {{ "{{passp:NAME}}" }} placeholders become `passp show NAME` at apply time).
# The homelab Makefile copies it to cloud-sync/.env; make secrets.push ships it
{{- range $k, $v := .homelab.cloud_sync }}
{{ $k }}={{ includeTemplate "passp" (toString $v) }}
{{- end }}
