# gatus/.env of ~/src/personal/homelab, rendered by dotfiles from
# [data.homelab.gatus] in the private toml (keys as in .env.example;
# {{ "{{passp:NAME}}" }} placeholders become `passp show NAME` at apply time).
# The homelab Makefile copies it to gatus/.env; make secrets.push ships it
{{- range $k, $v := .homelab.gatus }}
{{ $k }}={{ includeTemplate "passp" (toString $v) }}
{{- end }}
