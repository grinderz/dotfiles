# Output profiles, applied automatically by kanshi based on which
# monitors are connected (a profile matches when the connected set is
# exactly the outputs listed in it). Matching is by "make model serial"
# so it does not depend on DP-N connector numbers, which change between
# ports and docks. Positions are in logical (scaled) coordinates.

# Two Dells + builtin
profile docked {
	output "{{ .desktop.output_left }}" position 0,0
	output "{{ .desktop.output_right }}" position 2560,0
	output eDP-1 position 5120,0 scale 1.5
}

