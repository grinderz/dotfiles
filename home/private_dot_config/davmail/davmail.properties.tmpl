# DavMail in headless server mode: bridges the self-hosted Exchange
# (EWS URL from data.mail.davmail_url in the private chezmoi.toml) to
# local IMAP/SMTP/CalDAV on loopback only. Run by davmail.service; used
# by every kind = "davmail" mail account.
davmail.server=true
davmail.mode=EWS
davmail.url={{ .mail.davmail_url }}
davmail.bindAddress=127.0.0.1
davmail.allowRemote=false
davmail.imapPort=1143
davmail.smtpPort=1025
davmail.caldavPort=1080
# IMAP IDLE (minutes between folder checks); 0 disables it and the push
# watcher (goimapnotify) would drop to polling for this account
davmail.imapIdleDelay=1
# unused protocols off
davmail.popPort=
davmail.ldapPort=
davmail.disableUpdateCheck=true
davmail.disableGuiNotifications=true
# DavMail always adds a file appender (it is skipped only under docker or
# podman) and falls back to davmail.log in the working directory, which for
# the user unit is $HOME. Point it at the unbacked subvolume instead so the
# log stops landing in snapshots; DavMail creates the directory itself and
# keeps its own rotation at 1MB with two backups. Everything also reaches
# journald through the console appender: journalctl --user -u davmail.
davmail.logFilePath={{ .chezmoi.homeDir }}/.unbacked/davmail/davmail.log
# davmail logs at DEBUG by default, which is every IMAP command in both the
# file and the journal.
log4j.logger.davmail=INFO
