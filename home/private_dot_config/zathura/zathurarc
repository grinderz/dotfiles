# zathura, the PDF viewer xdg-open hands application/pdf to
# (mimeapps.list). Vim keys are the default binding set; what follows is
# the dark reading mode and the few defaults worth flipping.

# invert the page instead of dimming the window: white paper at night is
# the actual problem, and recolor keeps the contrast of the text
set recolor true
set recolor-keephue true
# Tokyo Night Storm (folke/tokyonight.nvim extras/zathura), recolor
# colours included
include "tokyonight_storm.zathurarc"

# the chrome around the page, close to the bar palette

# open where the document was left, and keep more of them
set database sqlite
set window-title-basename true
set selection-clipboard clipboard
set scroll-step 80
set smooth-scroll true
set adjust-open width
