// -*- mode: jsonc -*-
{{- /* project filter for the gitlab module comes from the private
       chezmoi.toml ([data.work] gitlab_exclude), so group names never
       land in the repo */ -}}
{{- $gitlabExclude := "" -}}
{{- if hasKey . "work" }}{{ if hasKey .work "gitlab_exclude" }}{{ $gitlabExclude = .work.gitlab_exclude }}{{ end }}{{ end }}
{
    // "layer": "top", // Waybar at top layer
    "position": "bottom",
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "custom/recording",
        "mpris",
        "privacy",
        "tray",
        "group/outside",
        "group/work",
        "group/devices",
        "group/system",
        "sway/language",
        "clock",
        "group/toggles",
        "custom/power"
    ],
    // Framed groups (see #work/#system in style.css); drawers hide quiet
    // modules behind a handle, counters and alerts stay visible. The media
    // modules are ungrouped on purpose: all three hide themselves when idle
    // and waybar never hides a group, so a frame around them would be left
    // standing empty.
    "group/outside": {
        "orientation": "inherit",
        "modules": ["custom/weather", "custom/car-traffic", "custom/starline"]
    },
    "group/work": {
        "orientation": "inherit",
        "modules": ["custom/gitlab", "custom/jira", "custom/mail"]
    },
    "group/devices": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "drawer-child"
        },
        "modules": ["bluetooth", "custom/usb"]
    },
    "group/system": {
        "orientation": "inherit",
        "modules": ["custom/system-stats", "network#eth", "network#wifi", "pulseaudio", "battery"]
    },
    // Modules configuration
    // "sway/workspaces": {
    //     "disable-scroll": true,
    //     "all-outputs": true,
    //     "warp-on-scroll": false,
    //     "format": "{name}: {icon}",
    //     "format-icons": {
    //         "1": "",
    //         "2": "",
    //         "3": "",
    //         "4": "",
    //         "5": "",
    //         "urgent": "",
    //         "focused": "",
    //         "default": ""
    //     }
    // },
    "sway/language": {
        "format": "{flag}",
        "tooltip-format": "{long}"
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "mpris": {
        "format": "{status_icon} {dynamic}",
        "format-stopped": "",
        "dynamic-order": ["artist", "title"],
        "dynamic-len": 40,
        "status-icons": {
            "playing": "▶",
            "paused": "⏸"
        },
        "tooltip-format": "{player} ({status}): {dynamic}"
    },
    "privacy": {
        "icon-size": 14,
        "modules": [
            {"type": "screenshare"},
            {"type": "audio-in"}
        ]
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10,
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    "clock": {
        // "timezone": "America/New_York",
        "format": "W{:%V %a %e %b %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "W{:%V %Y-%m-%d}"
    },
    "battery": {
        // pin to the real battery and adapter: scanning all of
        // /sys/class/power_supply hits the transient ucsi-source-psy nodes,
        // whose disappearance mid-read crashes waybar with an uncaught
        // ios_base::failure
        "bat": "BAT1",
        "adapter": "ACAD",
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
        }
    },
    // Two instances instead of one: a single network module follows the
    // default route, so the wired link (lower metric) always wins and the
    // wireless one is never drawn. Each is pinned to its own interface and
    // hides itself while that link is down.
    "network#eth": {
        "interface": "eth*",
        "format-ethernet": " {ipaddr}/{cidr}",
        "format-linked": " {ifname}(No IP)",
        "format-disconnected": "",
        "tooltip-format": "{ifname} via {gwaddr}",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "network#wifi": {
        "interface": "wlan*",
        "format-wifi": " {essid}({signalStrength}%)",
        "format-linked": " {ifname}(No IP)",
        "format-disconnected": "",
        // waybar keeps one default route (the lowest metric, here the
        // wired one), so {gwaddr} is always empty on this instance.
        "tooltip-format-wifi": "{ifname} {ipaddr}/{cidr}\n{essid} {signalStrength}% ({frequency} GHz)",
        // impala is the iwd TUI (networks, signal, connect). No format-alt
        // here: waybar toggles it on left click and format-alt-click did
        // not move that off the button, which swallowed the click. The
        // interface and address it showed are in the tooltip anyway.
        "on-click": "foot --app-id=mixer impala"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}% {format_source}",
        "format-bluetooth": "{icon}  {volume}% {format_source}",
        "format-bluetooth-muted": " {icon}  {format_source}",
        "format-muted": " {format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "foot --app-id=mixer wiremix"
    },
    "bluetooth": {
        "format": "󰂯 {status}",
        "format-connected": "󰂱 {num_connections}",
        "format-disabled": "",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "on-click": "foot --app-id=mixer bluetoothctl",
        "on-click-middle": "$HOME/.local/bin/bt-power toggle"
    },
    "custom/car-traffic": {
        "exec": "$HOME/.local/bin/car-traffic",
        "return-type": "json",
        "format": " {}",
        "interval": 900,
        "on-click": "$HOME/.local/bin/car-traffic open"
    },
    "custom/starline": {
        "exec": "$HOME/.local/bin/starline-status",
        "return-type": "json",
        "format": "{}",
        "interval": 300,
        "on-click": "$HOME/.local/bin/starline-status map",
        "on-click-right": "$HOME/.local/bin/starline-status open"
    },
    "custom/weather": {
        "exec": "$HOME/.local/bin/weather",
        "return-type": "json",
        "interval": 900
    },
    "custom/recording": {
        "exec": "$HOME/.local/bin/screen-record status",
        "return-type": "json",
        "format": "{}",
        "interval": 60,
        "signal": 7,
        "on-click": "$HOME/.local/bin/screen-record region"
    },
    "custom/gitlab": {
        "exec": "$HOME/.local/bin/gitlab-status{{ if $gitlabExclude }} --exclude {{ $gitlabExclude | shellQuote }}{{ end }}",
        "return-type": "json",
        "format": "{}",
        "interval": 120,
        "on-click": "$HOME/.local/bin/gitlab-status{{ if $gitlabExclude }} --exclude {{ $gitlabExclude | shellQuote }}{{ end }} pick",
        "on-click-right": "$HOME/.local/bin/gitlab-status open"
    },
    "custom/jira": {
        "exec": "$HOME/.local/bin/jira-status --sprint",
        "return-type": "json",
        "format": "{}",
        "interval": 300,
        "on-click": "$HOME/.local/bin/jira-status --sprint pick",
        "on-click-right": "$HOME/.local/bin/jira-status open"
    },
    "custom/mail": {
        "exec": "$HOME/.local/bin/mail-status",
        "return-type": "json",
        "format": "{}",
        "interval": 30,
        "on-click": "$HOME/.local/bin/mail-status pick",
        "on-click-right": "$HOME/.local/bin/mail-status open"
    },
    "custom/usb": {
        "exec": "$HOME/.local/bin/usb-storage status",
        "return-type": "json",
        "format": "{}",
        "interval": 15,
        "signal": 9,
        "on-click": "$HOME/.local/bin/usb-storage toggle",
        "on-click-right": "$HOME/.local/bin/usb-storage eject"
    },
    "custom/system-stats": {
        "exec": "$HOME/.local/bin/system-stats",
        "return-type": "json",
        "format": "{}",
        "interval": 60
    },
    // on/off switches folded behind one icon next to the power button:
    // hover the gear and the drawer slides the switches out, each with
    // its live state (the first module is the always-visible handle)
    "group/toggles": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "drawer-child"
        },
        "modules": [
            "custom/toggles-handle",
            "custom/nosuspend",
            "custom/conservation",
            "power-profiles-daemon",
            "custom/notify"
        ]
    },
    "custom/toggles-handle": {
        "format": "⚙",
        "tooltip": false
    },
    "custom/notify": {
        "exec": "$HOME/.local/bin/notify-toggle status",
        "return-type": "json",
        "interval": 60,
        "signal": 10,
        "on-click": "$HOME/.local/bin/notify-toggle toggle",
        "format": "{}",
        "tooltip": true
    },
    "custom/nosuspend": {
        "exec": "$HOME/.local/bin/suspend-toggle status",
        "return-type": "json",
        "interval": 60,
        "signal": 8,
        "on-click": "$HOME/.local/bin/suspend-toggle toggle",
        "format": "{}"
    },
    "custom/conservation": {
        "exec": "$HOME/.local/bin/battery-conservation status",
        "return-type": "json",
        "interval": 60,
        "on-click": "$HOME/.local/bin/battery-conservation toggle",
        "format": "{}",
        "tooltip": true
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
        "menu-actions": {
            "shutdown": "$HOME/.local/bin/power poweroff",
            "reboot": "$HOME/.local/bin/power reboot",
            "suspend": "systemctl suspend"
        }
    }
}
