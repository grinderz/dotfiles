/* Copy of the default /etc/xdg/waybar/style.css with only colors changed:
 * decorative per-module backgrounds removed, state indication kept as text color.
 * The colours are the roles of [theme] in .chezmoidata.toml (Tokyo Night
 * Storm); nothing below names a colour of its own. */

@define-color bg #{{ .theme.bg }};
@define-color bg_soft #{{ .theme.bg_soft }};
@define-color fg #{{ .theme.fg }};
@define-color fg_dim #{{ .theme.fg_dim }};
@define-color focused #{{ .theme.focused }};
@define-color border #{{ .theme.border }};
@define-color info #{{ .theme.info }};
@define-color warning #{{ .theme.warning }};
@define-color critical #{{ .theme.critical }};

* {
    /* `otf-font-awesome` is required to be installed for icons */
    font-family: FontAwesome, monospace;
    font-size: 14px;
}

window#waybar {
    background-color: @bg;
    border-top: 1px solid @border;
    color: @fg;
    transition-property: background-color;
    transition-duration: .5s;
}

window#waybar.hidden {
    opacity: 0.2;
}

/*
window#waybar.empty {
    background-color: transparent;
}
window#waybar.solo {
    background-color: @fg;
}
*/

window#waybar.termite {
    background-color: @bg_soft;
}

window#waybar.chromium {
    background-color: @bg_soft;
    border: none;
}

button {
    /* Use box-shadow instead of border so the text isn't offset */
    box-shadow: inset 0 -3px transparent;
    /* Avoid rounded borders under each button name */
    border: none;
    border-radius: 0;
}

/* https://github.com/Alexays/Waybar/wiki/FAQ#the-workspace-buttons-have-a-strange-hover-effect */
button:hover {
    background: inherit;
    box-shadow: inset 0 3px @fg;
}

/* you can set a style on hover for any module like this */
#pulseaudio:hover {
    background-color: rgba(0, 0, 0, 0.2);
}

#workspaces button {
    padding: 0 5px;
    background-color: transparent;
    color: @fg;
}

#workspaces button:hover {
    background: rgba(0, 0, 0, 0.2);
}

#workspaces button.focused, #workspaces button.active {
    background-color: @focused;
    box-shadow: inset 0 3px @fg;
}

#workspaces button.urgent {
    background-color: @critical;
}

/* a mode swallows plain h/j/k/l, so it has to be impossible to miss */
#mode {
    background-color: @critical;
    color: @fg;
    box-shadow: inset 0 3px @fg;
}

#clock,
#custom-car-traffic,
#custom-weather,
#custom-gitlab,
#custom-jira,
#custom-starline,
#custom-mail,
#custom-usb,
#battery,
#custom-system-stats,
#custom-nosuspend,
#custom-conservation,
#custom-notify,
#custom-toggles-handle,
#custom-power,
#network,
#pulseaudio,
#tray,
#mode,
#scratchpad,
#power-profiles-daemon,
#mpris {
    padding: 0 10px;
    color: @fg;
}

#window,
#workspaces {
    margin: 0 4px;
}

/* If workspaces is the leftmost module, omit left margin */
.modules-left > widget:first-child > #workspaces {
    margin-left: 0;
}

/* If workspaces is the rightmost module, omit right margin */
.modules-right > widget:last-child > #workspaces {
    margin-right: 0;
}

#clock {
    background-color: transparent;
}

/* plugged but not mounted: dim until a click mounts it */
#custom-usb.plugged {
    color: @info;
}

#battery {
    background-color: transparent;
    color: @fg;
}

#battery.charging, #battery.plugged {
    color: @fg;
    background-color: transparent;
}

@keyframes blink {
    to {
        background-color: transparent;
        color: @fg;
    }
}

/* Using steps() instead of linear as a timing function to limit cpu usage */
#battery.critical:not(.charging) {
    background-color: transparent;
    color: @critical;
    animation-name: blink;
    animation-duration: 0.5s;
    animation-timing-function: steps(12);
    animation-iteration-count: infinite;
    animation-direction: alternate;
}

#power-profiles-daemon {
    padding-right: 15px;
}

#power-profiles-daemon.performance {
    background-color: transparent;
    color: @critical;
}

#power-profiles-daemon.balanced {
    background-color: transparent;
    color: @fg;
}

#power-profiles-daemon.power-saver {
    background-color: transparent;
    color: @fg;
}

label:focus {
    background-color: @bg_soft;
}




#network {
    background-color: transparent;
}

#network.disconnected {
    background-color: transparent;
    color: @critical;
}

#pulseaudio {
    background-color: transparent;
    color: @fg;
}

#pulseaudio.muted {
    background-color: transparent;
    color: @fg_dim;
}






#custom-system-stats.critical {
    color: @critical;
}

#custom-gitlab.critical {
    color: @critical;
}

/* disarmed / battery getting low: yellow; alarm / battery too low to
   start: red — the later rule wins when both apply */
#custom-starline.warning,
#custom-starline.battery-low {
    color: @warning;
}

#custom-starline.critical,
#custom-starline.battery-critical {
    color: @critical;
}

#custom-recording.recording {
    color: @critical;
    padding: 0 10px;
}

#custom-replay.replay {
    color: @info;
    padding: 0 10px;
}

/* a pipeline is running: dim until it settles */
#custom-gitlab.running,
/* syncthing moving data: dim; a device away: yellow; folder errors: red */
#custom-syncthing.running {
    color: @info;
}

#custom-syncthing.warning {
    color: @warning;
}

#custom-syncthing.critical {
    color: @critical;
}

#tray {
    background-color: transparent;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    background-color: @critical;
}







#language {
    background: transparent;
    color: @fg;
    padding: 0 5px;
    margin: 0 5px;
    min-width: 16px;
}




#scratchpad {
    background: rgba(0, 0, 0, 0.2);
}

#scratchpad.empty {
    background-color: transparent;
}

#mpris.paused {
    color: @fg_dim;
}

/* module groups: clusters on a slightly darker pill, no outline — a
 * line had the bar's top stripe to collide with; tighter padding
 * inside (the tray is a pill too so its assorted icons read as one
 * cluster) */
#outside,
#work,
#devices,
#system,
#toggles,
#tray {
    /* the top margin also clears the bar's 1px top line */
    margin: 3px 2px 2px;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.15);
}

#outside > widget > *,
#work > widget > *,
#devices > widget > *,
#system > widget > *,
#toggles > widget > * {
    padding: 0 6px;
}

/* drawers (devices, toggles): children slide out of the handle on hover */
.drawer-child {
    background-color: rgba(0, 0, 0, 0.2);
}

#custom-notify.dnd {
    color: @warning;
}

/* traffic level: class comes from the feed's color */
#custom-car-traffic.yellow {
    color: @warning;
}

#custom-car-traffic.red {
    color: @critical;
}

#privacy {
    padding: 0;
}

#privacy-item {
    padding: 0 5px;
    color: white;
}

#privacy-item.screenshare {
    background-color: transparent;
}

#privacy-item.audio-in {
    background-color: transparent;
}

#privacy-item.audio-out {
    background-color: transparent;
}
