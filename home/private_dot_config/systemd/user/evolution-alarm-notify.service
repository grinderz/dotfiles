[Unit]
Description=Evolution meeting reminders (alarm notify daemon)
# pulled up by sway-session.target, after sway has imported the Wayland
# environment into the manager; stops with the session
PartOf=graphical-session.target
After=graphical-session.target
# skipped, not failed, on hosts without evolution-data-server
ConditionPathExists=/usr/lib/evolution-data-server/evolution-alarm-notify

[Service]
# pulls evolution-data-server up via D-Bus on start
ExecStart=/usr/lib/evolution-data-server/evolution-alarm-notify
Restart=on-failure
RestartSec=15
