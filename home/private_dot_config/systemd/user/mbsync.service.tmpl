[Unit]
Description=Sync mail with mbsync, then refresh the notmuch index
Wants=davmail.service
After=davmail.service network-online.target

[Service]
Type=oneshot
# a pinentry or YubiKey touch nobody answers must fail the run, not hang
# the timer forever; big first syncs still fit
TimeoutStartSec=30min
ExecStartPre=/usr/bin/mkdir -p{{ range .mail.accounts }} %h/{{ $.paths.mail }}/{{ .name }}{{ end }}
# Retries: a dropped connection to a single account makes mbsync exit 1
# even when every other mailbox synced, and that marked the whole run
# failed. Google's IMAP TLS handshakes get cut from here in the evenings
# (unexpected eof), a second try 30 s later often dies the same way, so
# a third one waits longer. A real breakage (expired token, davmail
# down) still fails all three; the timer runs every five minutes anyway.
ExecStart=/bin/sh -c '/usr/bin/mbsync -a || { sleep 30; /usr/bin/mbsync -a; } || { sleep 90; exec /usr/bin/mbsync -a; }'
ExecStartPost=/usr/bin/notmuch new
# retry queued outgoing mail (msmtpq) before the notifier looks at the
# queue; a still-failing send must not mark the sync failed
ExecStartPost=-%h/.local/bin/msmtp-queue -r
ExecStartPost=%h/.local/bin/mail-notify
