[Unit]
Description=IMAP IDLE push that triggers mbsync
Wants=davmail.service
After=davmail.service network-online.target
# goimapnotify reconnects on its own only once connected: a dial that fails
# five times in a row (about 15 s, a wifi roam or a proxy restart) is fatal
# and the process exits 1, so restarts must outlast a network flap. A broken
# config fails every 30 s and shows up in the journal instead.
StartLimitIntervalSec=10min
StartLimitBurst=10

[Service]
# -wait batches a burst of pushes into one sync
ExecStart=/usr/bin/goimapnotify -wait 5 -conf %h/.config/goimapnotify/config.yaml
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
