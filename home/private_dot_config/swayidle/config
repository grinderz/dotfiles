timeout 600 '$HOME/.local/bin/lock'
timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
# suspend on idle only when on battery; ACAD online = 1 means AC plugged
timeout 900 '[ "$(cat /sys/class/power_supply/ACAD/online)" = 0 ] && systemctl suspend'
before-sleep '$HOME/.local/bin/lock'
