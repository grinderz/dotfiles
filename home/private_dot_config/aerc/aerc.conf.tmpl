# Minimal aerc setup: mail lives in local maildirs (synced by mbsync,
# indexed by notmuch), so the UI never waits on a server. Accounts are in
# accounts.conf.

[ui]
# shipped styleset (/usr/share/aerc/stylesets); nord / dracula /
# solarized-dark are the one-word alternatives
styleset-name = catppuccin
threading-enabled = true
mouse-enabled = true
folders-sort = INBOX,Drafts,Sent,Trash

[compose]
# explicit: $EDITOR is only set in interactive fish, not when launched
# from the app launcher
editor = nvim
# complete To/Cc from the notmuch index (everyone ever mailed with);
# absolute path: aerc runs this without a shell, and the sway session
# PATH lacks ~/.local/bin
address-book-cmd = {{ .chezmoi.homeDir }}/.local/bin/mail-addr "%s"

[viewer]
# images referenced as cid: from HTML mail get inlined as data: URLs, so
# :open shows them in the browser; the terminal filter stays text-only
# (this w3m has no -sixel)
html-inline-images = true

[filters]
text/plain = colorize
text/calendar = calendar
message/delivery-status = colorize
message/rfc822 = colorize
# the html filter needs w3m and dante (socksify) installed
text/html = html | colorize
