# One aerc account per entry in [[data.mail.accounts]] (private
# chezmoi.toml). Every account reads the local notmuch-indexed maildir
# tree that mbsync keeps in sync (see ~/.config/isyncrc); only sending
# talks to a server. Account schema is documented in isyncrc.tmpl. The
# notmuch source carries no path: aerc 0.22 takes the database and mail
# root from the notmuch config (maildir-store went away for the same
# reason).
#
# Accounts with a `group` also get a combined tab per group, listed first:
# a notmuch query-map folds the same folder of every member into one
# list (INBOX, Sent, Archive, plus Recent for the last 30 days). The
# member account of a message is read from its file path, so the binds
# in binds.conf reply, archive and trash through the right mailbox
# (:reply -A, :mv <account>/Archive); :archive itself does not work
# there. The first member is the tab's default identity for :compose.
{{- $groups := list }}
{{- range .mail.accounts }}{{ if hasKey . "group" }}{{ if not (has .group $groups) }}{{ $groups = append $groups .group }}{{ end }}{{ end }}{{ end }}
{{- range $g := $groups }}
{{- $first := dict }}
{{- range $.mail.accounts }}{{ if and (eq (get . "group") $g) (not $first) }}{{ $first = . }}{{ end }}{{ end }}

[{{ $g }}]
source = notmuch://
query-map = {{ $.chezmoi.homeDir }}/.config/aerc/querymap-{{ $g }}.conf
# only the combined views in the sidebar, not every member's maildir
folders = INBOX,Recent,Sent,Archive
{{ template "aerc-outgoing" (dict "a" $first "home" $.chezmoi.homeDir) -}}
from = {{ default $.personal.name (get $first "realname") }} <{{ $first.email }}>
check-mail-cmd = systemctl --user start mbsync.service
check-mail-timeout = 60s
default = INBOX
postpone = {{ $first.name }}/Drafts
{{- end }}
{{ range .mail.accounts }}
[{{ .name }}]
source = notmuch://
maildir-account-path = {{ .name }}
{{ template "aerc-outgoing" (dict "a" . "home" $.chezmoi.homeDir) -}}
from = {{ default $.personal.name (get . "realname") }} <{{ .email }}>
# :check-mail kicks the same unit the timer uses (mbsync -a + notmuch
# new); systemd serializes concurrent starts, so no race with the timer
check-mail-cmd = systemctl --user start mbsync.service
check-mail-timeout = 60s
default = INBOX
archive = Archive
postpone = Drafts
{{ end }}
