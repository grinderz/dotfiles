Y = :send<Enter> # Send
n = :abort<Enter> # Abort (discard message, no confirmation)
s = :sign<Enter> # Toggle signing
x = :encrypt<Enter> # Toggle encryption to all recipients
v = :preview<Enter> # Preview message
p = :postpone<Enter> # Postpone
q = :choose -o d discard abort -o p postpone postpone<Enter> # Abort or postpone
e = :edit<Enter> # Edit (body and headers)
a = :menu -c 'fd . --type=f | fzf -m' attach<Enter> # Add attachments (fzf, multi-select)
A = :attach<space> # Add attachment by path
d = :detach<space> # Remove attachment

[terminal]
$noinherit = true
$ex = <C-x>

<C-p> = :prev-tab<Enter>
<C-n> = :next-tab<Enter>
<C-PgUp> = :prev-tab<Enter>
<C-PgDn> = :next-tab<Enter>

# Gmail: a folder is a label, so expunging a message from INBOX (what
# :delete becomes once mbsync pushes it) only drops the Inbox label and the
# message lives on in All Mail. Only [Gmail]/Trash really deletes, so on
# gmail accounts d/D move the message to the local Trash maildir, which
# mbsync's -trash channel mirrors there; Gmail purges it after 30 days.
# Inside Trash itself :delete is right (expunge from the last label).
[[- range .mail.accounts ]]
[[- if hasPrefix "gmail" .kind ]]

[messages:account=[[ .name ]]]
d = :choose -o y 'Really trash this message' 'move Trash'<Enter>
D = :move Trash<Enter>

[messages:account=[[ .name ]]:folder=Trash]
d = :choose -o y 'Really delete this message' delete-message<Enter>
D = :delete<Enter>

[view:account=[[ .name ]]]
D = :move Trash<Enter>

[view:account=[[ .name ]]:folder=Trash]
D = :delete<Enter>
[[- end ]]
[[- end ]]

# Combined group tabs (accounts.conf): every message there belongs to some
# member account, read from its maildir path (<paths.mail>/<name>/ is
# segment N of the file name). Replies go out through that account
# (-A) and archive/trash move within it, since :archive has no target on
# a query-map folder. Trash everywhere: the gmail members need it, and
# the others have a Trash folder too.
[[- $acct := printf "{{index (.Filename | split \"/\") %d}}" (add (len (splitList "/" .chezmoi.homeDir)) (len (splitList "/" .paths.mail))) ]]
[[- $groups := list ]]
[[- range .mail.accounts ]][[ if hasKey . "group" ]][[ if not (has .group $groups) ]][[ $groups = append $groups .group ]][[ end ]][[ end ]][[ end ]]
[[- range $g := $groups ]]

[messages:account=[[ $g ]]]
rr = :reply -a -A [[ $acct ]]<Enter>
rq = :reply -aq -A [[ $acct ]]<Enter>
Rr = :reply -A [[ $acct ]]<Enter>
Rq = :reply -q -A [[ $acct ]]<Enter>
a = :mv [[ $acct ]]/Archive<Enter>
A = :unmark -a<Enter>:mark -T<Enter>:mv [[ $acct ]]/Archive<Enter>
d = :choose -o y 'Really trash this message' 'mv [[ $acct ]]/Trash'<Enter>
D = :mv [[ $acct ]]/Trash<Enter>

[view:account=[[ $g ]]]
rr = :reply -a -A [[ $acct ]]<Enter>
rq = :reply -aq -A [[ $acct ]]<Enter>
Rr = :reply -A [[ $acct ]]<Enter>
Rq = :reply -q -A [[ $acct ]]<Enter>
A = :mv [[ $acct ]]/Archive<Enter>
D = :mv [[ $acct ]]/Trash<Enter>
[[- end ]]
