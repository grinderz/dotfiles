# Copied as-is from /usr/share/aerc/binds.conf (aerc defaults) to have a
# stable base for local tweaks; aerc-bindings renders it for the $mod+i
# cheatsheet picker. chezmoi templating uses double square brackets here
# (see the directive above) so that aerc's own {{ }} templates in binds
# pass through untouched.

# Binds are of the form <key sequence> = <command to run>
# To use '=' in a key sequence, substitute it with "Eq": "<Ctrl+Eq>"
# If you wish to bind #, you can wrap the key sequence in quotes: "#" = quit
<C-p> = :prev-tab<Enter>
<C-PgUp> = :prev-tab<Enter>
<C-n> = :next-tab<Enter>
<C-PgDn> = :next-tab<Enter>
\[t = :prev-tab<Enter>
\]t = :next-tab<Enter>
<C-t> = :term<Enter>
? = :help keys<Enter>
<C-c> = :prompt 'Quit?' quit<Enter>
<C-q> = :prompt 'Quit?' quit<Enter>
<C-z> = :suspend<Enter>
<C-o> = :menu -adc fzf :cf -a<Enter>

