#!/usr/bin/env bash
# forgit cheatsheet generated from what is installed, so it cannot drift:
# the aliases from the fish plugin (ga, glo, gd ... with the git-forgit
# subcommand behind each) and, from the package's README, what each one
# does plus the keys that work inside forgit's fzf views. Same four
# columns as the other sheets: context, keys, action, description.
# Shown in fuzzel under sway; fzf in the terminal elsewhere (the mac).

set -euo pipefail

plugin=""
for f in "${FORGIT_PLUGIN:-}" /usr/share/fish/vendor_conf.d/forgit.plugin.fish \
         "${HOMEBREW_PREFIX:-/opt/homebrew}/share/forgit/forgit.plugin.fish"; do
    [ -n "$f" ] && [ -r "$f" ] && { plugin=$f; break; }
done
[ -n "$plugin" ] || { echo "forgit-bindings: forgit is not installed" >&2; exit 1; }
# brew ships no README; without it the sheet has the actions, no prose
readme=""
for f in "${FORGIT_README:-}" /usr/share/doc/forgit/README.md; do
    [ -n "$f" ] && [ -r "$f" ] && { readme=$f; break; }
done

sheet() {
    # descriptions and fzf keys from the README's two tables
    if [ -n "$readme" ]; then
        awk '
            /^### Full Command List/ { t = "cmd"; next }
            /Keybindings/ { t = "key"; next }
            /^#/ { t = "" }
            t == "cmd" && /^\| `g/ {
                key = $2; gsub(/`/, "", key)
                desc = $0; sub(/^\| *`[^`]*` *\| */, "", desc); sub(/ *\|.*$/, "", desc)
                gsub(/`/, "", desc); sub(/^Interactive /, "", desc)
                print "desc\t" key "\t" desc
            }
            t == "key" && /^\| <kbd>/ {
                k = $0; sub(/^\| */, "", k); sub(/ *\|.*$/, "", k)
                gsub(/<\/?kbd>/, "", k); gsub(/ - /, "+", k); gsub(/ *\/ */, " / ", k)
                d = $0; sub(/^\|[^|]*\| */, "", d); sub(/ *\|.*$/, "", d)
                gsub(/<sup>[0-9]<\/sup>/, "", d)
                print "key\t" k "\t" d
            }
        ' "$readme"
    fi
    # the aliases: abbr -a -- (string collect $forgit_add; or string collect "ga") git-forgit add
    awk '
        /^[[:space:]]*abbr -a -- \(string collect \$forgit_/ {
            key = $0; sub(/^.*string collect "/, "", key); sub(/".*$/, "", key)
            act = $0; sub(/^.*"\) /, "", act)
            print "alias\t" key "\t" act
        }
    ' "$plugin"
}

sheet | awk -F'\t' '
    $1 == "desc" { desc[$2] = $3; next }
    $1 == "key"  { keys = keys sprintf("%-9s %-24s %-34s %s\n", "fzf", $2, "", $3); next }
    $1 == "alias" {
        line = sprintf("%-9s %-24s %-34s %s", "shell", $2, $3, ($2 in desc) ? desc[$2] : "")
        sub(/[[:space:]]+$/, "", line); print line
    }
    END { printf "%s", keys }
' | sed 's/[[:space:]]*$//' | {
    if command -v fuzzel >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        fuzzel --dmenu --width 110 >/dev/null || true
    else
        fzf --no-sort --layout=reverse --prompt='forgit> ' >/dev/null || true
    fi
}
