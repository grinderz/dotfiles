#!/bin/sh
# Graceful poweroff/reboot from the sway session. A bare systemctl
# poweroff tears the session down with SIGTERM/SIGKILL and browsers log
# it as a crash ("Brave quit unexpectedly", session restore prompt).
# Instead ask every sway view to close (xdg close request, same as
# clicking the titlebar X), wait until they are gone, then hand over to
# systemd. Apps that block on a "save changes?" prompt get 15s, after
# that shutdown proceeds anyway.
action=${1:?usage: power poweroff|reboot}

# When run from a terminal, the kill loop below closes that terminal too;
# the resulting SIGHUP must not take the script down before systemctl runs.
# stdio moves off the dying pty for the same reason.
trap '' HUP
exec </dev/null >/dev/null 2>&1

views() {
    swaymsg -t get_tree | jq '[.. | objects | select(.pid != null) | .id]'
}

# Outside a sway session (bare tty) there is nothing to close gracefully
if [ -n "$SWAYSOCK" ]; then
    for id in $(views | jq '.[]'); do
        swaymsg "[con_id=$id] kill" > /dev/null
    done

    i=0
    while [ "$(views | jq 'length')" -gt 0 ] && [ $i -lt 30 ]; do
        sleep 0.5
        i=$((i + 1))
    done
fi

# breadcrumb in the journal: stdio is detached and waybar swallows stderr,
# so a failing systemctl would otherwise vanish without a trace
systemctl "$action" 2>&1 | logger -t power
logger -t power "systemctl $action returned without effect"
