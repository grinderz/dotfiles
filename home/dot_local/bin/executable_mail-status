#!/usr/bin/env bash
# Waybar module for unread mail, straight from the local notmuch index:
# text is the total INBOX unread count, tooltip breaks it down per
# account. `pick` pops a fuzzel with per-account counts and the freshest
# unread messages — any selection just focuses (or starts) aerc. `open`
# skips the menu. Hidden entirely while notmuch is absent or all read,
# unless outgoing mail is stuck in the msmtpq queue.

set -euo pipefail

command -v notmuch >/dev/null || { echo '{"text": ""}'; exit 0; }
maildir=$(notmuch config get database.path)
[ -d "$maildir" ] || { echo '{"text": ""}'; exit 0; }
# the queue directory is whatever msmtpq itself uses
MSMTPQ_Q=""
# shellcheck source=/dev/null
[ -f "$HOME/.config/msmtpq/config" ] && . "$HOME/.config/msmtpq/config"

accounts() {
    find "$maildir/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
}

open_aerc() {
    exec "$HOME/.local/bin/launch-or-focus" aerc foot --app-id=aerc aerc
}

case "${1:-}" in
pick)
    {
        while read -r acc; do
            n=$(notmuch count "tag:unread and folder:$acc/INBOX")
            [ "$n" -gt 0 ] && printf '%-16s %3d unread\n' "$acc" "$n"
        done < <(accounts)
        notmuch search --output=summary --format=json --limit=15 \
                'tag:unread and folder:/INBOX/' \
            | jq -r '.[] | "  \(.authors) — \(.subject)"'
    } | fuzzel --dmenu --width 90 >/dev/null && open_aerc
    ;;
open)
    open_aerc
    ;;
*)
    total=0
    tooltip=""
    while read -r acc; do
        n=$(notmuch count "tag:unread and folder:$acc/INBOX")
        total=$((total + n))
        [ "$n" -gt 0 ] && tooltip="$tooltip$acc: $n unread\n"
    done < <(accounts)
    queued=0
    [ -d "$MSMTPQ_Q" ] && queued=$(find "$MSMTPQ_Q" -name '*.mail' | wc -l)
    if [ "$queued" -gt 0 ]; then
        tooltip="$tooltip$queued queued to send\n"
    fi
    if [ "$total" -eq 0 ] && [ "$queued" -eq 0 ]; then
        echo '{"text": ""}'
    else
        printf '{"text": "%s %d%s", "tooltip": "%s", "class": "%s"}\n' \
            "" "$total" "$([ "$queued" -gt 0 ] && printf ' ⇡%d' "$queued")" \
            "${tooltip%\\n}" "$([ "$queued" -gt 0 ] && echo queued || echo unread)"
    fi
    ;;
esac
