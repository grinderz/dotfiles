#!/usr/bin/env bash
# Clipboard history picker: cliphist's entries (text and images, stored by
# the two wl-paste watchers sway starts) through menu-pick, the chosen one
# goes back on the clipboard. Images show as "[[ binary data ... png ]]"
# in the list and come back as the image.
#
# Usage: clip-history          pick and copy
#        clip-history wipe     forget everything

set -euo pipefail

command -v cliphist >/dev/null 2>&1 || { notify-send -u low "Clipboard" "cliphist is not installed"; exit 1; }

if [ "${1:-}" = wipe ]; then
    cliphist wipe
    notify-send -t 2000 "Clipboard" "history wiped"
    exit 0
fi

# the id column stays hidden, the whole line comes back for decode
cliphist list | "$HOME/.local/bin/menu-pick" --with-nth=2 --prompt="clip " | cliphist decode | wl-copy
