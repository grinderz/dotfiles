#!/usr/bin/env bash
# Keybinding cheatsheet generated from the live zellij config, so it can
# never drift from reality: every bind in the keybinds block with its mode
# and actions, shown in fuzzel. Selection is just for browsing (nothing
# runs). Companion of sway-bindings.

set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/zellij/config.kdl"
[ -r "$config" ] || exit 0

awk '
    function braces(s,    i, d) {
        d = 0
        for (i = 1; i <= length(s); i++) {
            if (substr(s, i, 1) == "{") d++
            else if (substr(s, i, 1) == "}") d--
        }
        return d
    }
    function emit(s, m,    key, act) {
        gsub(/[[:space:]]+/, " ", s)
        sub(/^ ?bind "/, "", s)
        key = s
        sub(/".*/, "", key)
        act = s
        sub(/^[^"]*" *\{ */, "", act)
        sub(/ *;? *\} *$/, "", act)
        # plugin option blocks (floating true ...) add nothing here
        gsub(/ *\{[^{}]*\}/, "", act)
        # dropping back to locked is the normal exit, not an action (multi-
        # line binds lose their semicolons, hence the [; ] alternative)
        sub(/[; ] *SwitchToMode "locked" *;?$/, "", act)
        gsub(/"/, "", act)
        printf "%-21s %-12s %s\n", m, key, act
    }
    /^keybinds/ { in_kb = 1 }
    !in_kb { next }
    {
        if (collecting) {
            buf = buf " " $0
            bdepth += braces($0)
            if (bdepth <= 0) { emit(buf, mode); collecting = 0 }
            depth += braces($0)
            next
        }
        # a block opening at depth 1 is a mode (or shared_* group) header
        if (depth == 1 && $0 ~ /\{[[:space:]]*$/ && $0 !~ /bind /) {
            mode = $0
            sub(/^[[:space:]]*/, "", mode)
            sub(/[[:space:]]*\{.*$/, "", mode)
            if (mode ~ /^shared_among "[^"]*" "[^"]*"$/) {
                sub(/^shared_among[[:space:]]*/, "", mode)
                gsub(/" "/, "+", mode)
                gsub(/"/, "", mode)
            } else if (mode ~ /^shared_/)
                # the full except/among lists are too wide for a column
                mode = "shared"
        }
        if ($0 ~ /^[[:space:]]*bind "/) {
            if (braces($0) > 0) {
                collecting = 1
                buf = $0
                bdepth = braces($0)
            } else
                emit($0, mode)
        }
        depth += braces($0)
        if (depth <= 0) in_kb = 0
    }
' "$config" | fuzzel --dmenu --width 110 >/dev/null || true
