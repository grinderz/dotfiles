#!/usr/bin/env bash
# Single entry point for the cheatsheets: a small picker chooses the
# category, the matching sheet opens, and Escape in a sheet comes back
# here. Escape in the picker quits. New sheets are one case line away.
#
# Under sway the picker is fuzzel. Elsewhere (the mac) it is fzf, and
# without a terminal the script first reopens itself in a floating
# Alacritty — the same window aerospace-bindings used to open on its own,
# the AeroSpace rule on the "cheatsheet" title floats it.

set -euo pipefail

bin=$(dirname "$(readlink -f "$0")")

if command -v fuzzel >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
    sheets="sway zellij aerc forgit scripts fish task"
    pick() { fuzzel --dmenu --prompt 'cheatsheet> ' --width 30 --lines "$1"; }
else
    if [ ! -t 1 ]; then
        exec open -na Alacritty --args -T cheatsheet -e "$0"
    fi
    sheets="aerospace zellij forgit scripts fish task"
    pick() { fzf --no-sort --layout=reverse --prompt='cheatsheet> ' --height "$(( $1 + 3 ))"; }
fi

# shellcheck disable=SC2086
n=$(printf '%s\n' $sheets | wc -l)
while :; do
    # shellcheck disable=SC2086
    cat=$(printf '%s\n' $sheets | pick "$n") || exit 0
    case $cat in
        sway) "$bin/sway-bindings" ;;
        aerospace) "$bin/aerospace-bindings" ;;
        zellij) "$bin/zellij-bindings" ;;
        aerc) "$bin/aerc-bindings" ;;
        forgit) "$bin/forgit-bindings" ;;
        scripts) "$bin/scripts-sheet" ;;
        fish) "$bin/fish-sheet" ;;
        task) "$bin/task-sheet" ;;
    esac
done
