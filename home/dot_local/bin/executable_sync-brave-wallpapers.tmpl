#!/bin/sh
# Copy new Brave NTP background images into the wallpaper directory.
# Brave keeps them in a versioned component dir that gets replaced on
# component updates, so anything worth keeping must be copied out.
# The component is located by its manifest name, not the hardcoded id.
#
# Usage: sync-brave-wallpapers [-n|--dry-run]   -n only lists what a run
# would copy. Nothing is ever overwritten or removed either way.
set -eu

dry=0
case "${1:-}" in
    -n | --dry-run) dry=1 ;;
    "") ;;
    *) echo "usage: ${0##*/} [-n|--dry-run]" >&2; exit 2 ;;
esac

root="$HOME/.config/BraveSoftware/Brave-Browser"
# macOS keeps the profile under Application Support (note the space)
[ -d "$root" ] || root="$HOME/Library/Application Support/BraveSoftware/Brave-Browser"

dest={{ .desktop.wallpaper_dir | shellQuote }}
case "$dest" in "~"*) dest="$HOME${dest#\~}" ;; esac

manifests=$(grep -ls 'Brave NTP background images' "$root"/*/*/manifest.json 2>/dev/null) \
    || { echo "error: Brave NTP background images component not found under $root" >&2; exit 1; }
mkdir -p "$dest"

added=0
# one manifest per line: the path may contain spaces
while IFS= read -r manifest; do
    src=${manifest%/manifest.json}
    for img in "$src"/*.jpg "$src"/*.png "$src"/*.webp; do
        [ -e "$img" ] || continue
        base=$(basename "$img")
        if [ ! -e "$dest/$base" ]; then
            if [ "$dry" = 1 ]; then
                echo "would add $base"
            else
                cp "$img" "$dest/"
                echo "added $base"
            fi
            added=$((added + 1))
        fi
    done
done <<EOF_MANIFESTS
$manifests
EOF_MANIFESTS

if [ "$dry" = 1 ]; then
    echo "$added would be added, $(ls "$dest" | wc -l) already in $dest"
else
    echo "$added new, $(ls "$dest" | wc -l) total in $dest"
fi
