#!/usr/bin/env python3
"""Move Codex transcripts into a shared folder without copying live SQLite state."""

import argparse
import os
from pathlib import Path


def migrate(home, store):
    home = home.expanduser().absolute()
    store = store.expanduser().absolute()
    if store == home or home in store.parents:
        raise ValueError('the shared folder must be outside CODEX_HOME')
    home.mkdir(parents=True, exist_ok=True)
    store.mkdir(parents=True, exist_ok=True)
    pairs = [(home / name, store / name) for name in ('sessions', 'archived_sessions')]

    # Check both directories before moving either. Never merge two histories
    # implicitly: a shared folder may already contain a newer or divergent file.
    for source, target in pairs:
        if source.is_symlink():
            if source.resolve() != target.resolve():
                raise ValueError(f'{source} points elsewhere; refusing to replace it')
        elif source.exists():
            if not source.is_dir():
                raise ValueError(f'{source} is not a directory')
            if target.exists():
                raise ValueError(f'both {source} and {target} exist; reconcile them before retrying')
            if source.stat().st_dev != store.stat().st_dev:
                raise ValueError(f'{source} and {store} must be on the same filesystem for a live move')
        if target.exists() and (not target.is_dir() or target.is_symlink()):
            raise ValueError(f'{target} must be a real directory')

    for source, target in pairs:
        if source.is_symlink():
            target.mkdir(parents=True, exist_ok=True)
            continue
        if source.exists():
            # Rename preserves the inode: an already open transcript keeps
            # receiving writes in the shared folder, including this session.
            source.rename(target)
        else:
            target.mkdir(parents=True, exist_ok=True)
        try:
            source.symlink_to(target, target_is_directory=True)
        except OSError:
            # A failed link must not leave the old local path missing.
            if not source.exists() and not source.is_symlink():
                target.rename(source)
            raise
        print(f'{source} -> {target}')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('store', type=Path, help='shared Codex transcript folder')
    parser.add_argument('--codex-home', type=Path, default=Path(os.environ.get('CODEX_HOME', '~/.codex')))
    args = parser.parse_args()
    try:
        migrate(args.codex_home, args.store)
    except (OSError, ValueError) as error:
        parser.exit(1, f'codex-sync-state: {error}\n')
