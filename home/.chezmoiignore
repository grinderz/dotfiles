# mail stack renders only when accounts are defined in the private toml
{{ if not (hasKey . "mail") }}
.config/aerc
.config/isyncrc
.config/notmuch
.config/oama
.config/systemd/user/mbsync.service
.config/systemd/user/mbsync.timer
.config/systemd/user/davmail.service
{{ end }}

# davmail only bridges Exchange accounts; ewsctl talks to the same server
{{ if not (and (hasKey . "mail") (hasKey .mail "davmail_url")) }}
.config/davmail
.config/ewsctl
{{ end }}

