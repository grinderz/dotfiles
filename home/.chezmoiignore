{{ if not (hasKey . "work") }}
.config/git/config.work.inc
{{ end }}

# the JetBrains vmoptions block is written only when options are listed in
# the private toml
{{ if not (hasKey . "jetbrains") }}
.chezmoiscripts/jetbrains-vmoptions.sh
{{ end }}

# car status module renders only with [data.starline] in the private toml
{{ if not (hasKey . "starline") }}
.config/starline-status
{{ end }}

# mail stack renders only when accounts are defined in the private toml
{{ if not (hasKey . "mail") }}
.config/aerc
.config/isyncrc
.config/notmuch
.config/oama
.config/systemd/user/mbsync.service
.config/systemd/user/mbsync.timer
.config/systemd/user/davmail.service
{{ end }}

# davmail only bridges Exchange accounts; ewsctl talks to the same server
{{ if not (and (hasKey . "mail") (hasKey .mail "davmail_url")) }}
.config/davmail
.config/ewsctl
{{ end }}

# the pass -> Bitwarden list renders only when entries are picked in the
# private toml; the script itself stays, it takes a list path as argument
{{ if not (hasKey . "rbw") }}
.config/pass-rbw-sync.list
{{ end }}

# calendar stack renders only when accounts are defined in the private toml
{{ if not (hasKey . "cal") }}
.config/khal
.config/vdirsyncer
.config/systemd/user/vdirsyncer.service
.config/systemd/user/vdirsyncer.timer
{{ end }}
