{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Renovate on GitHub updates workflow actions, pre-commit hooks, Ruff, pre-commit, ShellCheck and the chezmoi binary used in CI."
  ],
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": [
    "every weekend"
  ],
  "prConcurrentLimit": 5,
  "semanticCommits": "enabled",
  "baseBranchPatterns": [
    "main"
  ],
  "enabledManagers": [
    "github-actions",
    "pre-commit",
    "custom.regex"
  ],
  "pre-commit": {
    "enabled": true
  },
  "branchPrefix": "renovate/",
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "pre-commit hooks in their own PR",
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit hooks"
    }
  ],
  "customDatasources": {
    "chezmoi-release": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/twpayne/chezmoi/releases?per_page=10",
      "transformTemplates": [
        "[$[draft = false and prerelease = false].($v := $substringAfter(tag_name, 'v'); {'version': $v, 'releaseTimestamp': published_at, 'hash': assets[name = ('chezmoi_' & $v & '_linux_amd64.tar.gz')].digest})]",
        "{'sourceUrl': 'https://github.com/twpayne/chezmoi', 'releases': [$[$type(hash) = 'string'][$contains(hash, /^sha256:[0-9a-f]{64}$/)].{'version': version, 'releaseTimestamp': releaseTimestamp, 'digest': $substringAfter(hash, 'sha256:')}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "ruff, run through uvx at the version of the Makefile",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "RUFF_VERSION \\?= (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "ruff",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "pre-commit, run through uvx at the version of the Makefile",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "PRE_COMMIT_VERSION \\?= (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "pre-commit",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "shellcheck release installed by the CI lint job",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "SHELLCHECK_VERSION: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "koalaman/shellcheck",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the CI chezmoi version and its Linux amd64 archive checksum together",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "CHEZMOI_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)\\r?\\n[ \\t]+CHEZMOI_SHA256: (?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "twpayne/chezmoi",
      "datasourceTemplate": "custom.chezmoi-release",
      "versioningTemplate": "semver"
    }
  ]
}
